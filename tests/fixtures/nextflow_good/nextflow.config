// A clean pipeline. Provenix must report zero findings on this file.
// Documentation links in comments must never be read as reference data:
//   https://www.nextflow.io/docs/latest/config.html
//   https://q2-sidle.readthedocs.io/en/latest/reconstruction.html
//   https://github.com/nf-core/modules/blob/master/README.md

params {
    outdir      = 'results'
    // Metadata URLs, not data.
    homePage    = 'https://github.com/example/good/tree/main'
    doi         = 'https://doi.org/10.5281/zenodo.1400710'
    // Reference data: immutable revision, and verified below.
    ref_fasta   = 'https://raw.githubusercontent.com/example/refs/9f1614baeb0ddf66e60be78c3d9fa55440465ac8/genome.fa'
    ref_md5     = 'd41d8cd98f00b204e9800998ecf8427e'
}

manifest {
    name    = 'example/good'
    version = '1.2.0'
}
