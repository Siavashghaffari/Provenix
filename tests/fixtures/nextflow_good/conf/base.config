process {
    // Global defaults every process inherits, the nf-core pattern.
    cpus          = { 1    * task.attempt }
    memory        = { 6.GB * task.attempt }
    time          = { 4.h  * task.attempt }
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
    }

    withName: 'FASTQC' {
        // A seed set in config, not in the script. This is where nf-core puts them.
        ext.args   = '--seed 1'
        publishDir = [
            [
                path: { "${params.outdir}/fastqc" },
                mode: params.publish_dir_mode,
                pattern: "*.html"
            ]
        ]
    }
}
