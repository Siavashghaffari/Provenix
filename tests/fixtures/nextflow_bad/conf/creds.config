params {
    // PVX030: a credential-shaped literal. The value must never appear in output.
    //
    // Deliberately not a vendor-shaped key. A literal matching a real provider
    // pattern — an AWS key ID, a Google API key — is indistinguishable from a
    // live credential to a secret scanner, so committing one produces a real
    // alert on a fake value. The vendor shapes are generated at test time; see
    // tests/conftest.py.
    db_password    = 'hunter2-not-a-real-password'

    // References, not secrets. Neither may be flagged.
    token_from_env = "${System.getenv('CI_TOKEN')}"
    api_key        = "${params.injected_key}"
}
